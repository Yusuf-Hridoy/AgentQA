# Copy this file to .env and fill in the keys you have.
# .env is in .gitignore, so your keys never reach the repository.
# AgentQA reads keys only from the environment. It never writes one to a log,
# a trace or results.json.

# Groq: free key from https://console.groq.com/keys
GROQ_API_KEY=

# Gemini, also used by the AI judge: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Qwen on Ollama needs no key.

# Any model id can be changed without touching the code.
# AGENTQA_LOCAL_MODEL=qwen3.5:4b
# AGENTQA_GROQ_MODEL=openai/gpt-oss-120b
# AGENTQA_GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama cuts long prompts when its context window is small.
# OLLAMA_CONTEXT_LENGTH=8192
